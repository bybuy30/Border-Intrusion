# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Forest Intrusion Detection System — .gitignore                             ║
# ║                                                                              ║
# ║  Rule of thumb:                                                              ║
# ║    • Commit source code, configs, docs, and placeholder .gitkeep files.     ║
# ║    • Never commit weights, datasets, secrets, generated artefacts,          ║
# ║      virtual environments, or anything > a few hundred KB.                  ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ── Python runtime ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyx.in
.Python
*.egg-info/
*.egg
MANIFEST
dist/
build/
wheels/
pip-wheel-metadata/
.installed.cfg
lib/
lib64/


# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
conda-env/


# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/
# Keep the actual notebook files — only ignore their checkpoint copies


# ── Model weights (large binary files) ───────────────────────────────────────
# All weight formats produced by Ultralytics / PyTorch / ONNX / TensorFlow
*.pt
*.pth
*.ckpt
*.bin         # HuggingFace-style weights
*.onnx
*.engine      # TensorRT
*.trt
*.torchscript
*.pb          # TensorFlow frozen graph
*.tflite
*.mlmodel     # Core ML
*.mlpackage/
*.openvino/

# Ultralytics download cache inside the project
models/*.pt
models/*.onnx
notebooks/yolov8n.pt
notebooks/*.pt
# Keep the placeholder so the directory is tracked
!models/.gitkeep


# ── Training and inference runs (large output directories) ────────────────────
runs/
!runs/.gitkeep
notebooks/runs/


# ── Datasets (images, labels, archives) ──────────────────────────────────────
# Raw images and label files — often hundreds of MB to several GB
datasets/**/images/
datasets/**/labels/

# Downloaded or extracted raw data — named subdirectories
datasets/raw/
datasets/extracted/
datasets/combined_yolo/
datasets/cpu_smoke_test/

# Any other generated dataset working directory
# ── Datasets (Ignore all dataset files and subfolders) ───────────────────────
datasets/*
!datasets/.gitkeep
!datasets/README.md

# Archive formats that might be downloaded
datasets/**/*.zip
datasets/**/*.7z
datasets/**/*.tar
datasets/**/*.tar.gz
datasets/**/*.tgz
datasets/**/*.rar

# Ultralytics dataset cache
*.cache
**/*.cache

# COCO-format annotation files downloaded alongside datasets
# (keep your own data.yaml and class_map.json — those are config, not data)
datasets/**/*.json
!configs/*.json

# Keep README files and YAML configs inside datasets/
!datasets/README.md
!datasets/**/README.md
!datasets/**/data.yaml


# ── Storage: evidence images and event databases ──────────────────────────────
# Evidence crops and full-frame saves
storage/evidence/
storage/events/*.db
storage/events/*.sqlite
storage/events/*.sqlite3
storage/events/*.json

# Keep directory structure markers
!storage/evidence/.gitkeep
!storage/events/.gitkeep


# ── Test videos ───────────────────────────────────────────────────────────────
test_videos/*.mp4
test_videos/*.avi
test_videos/*.mov
test_videos/*.mkv
test_videos/*.webm
test_videos/*.flv
test_videos/*.wmv
# Keep README and placeholder
!test_videos/README.md
!test_videos/.gitkeep


# ── Environment and secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
# Keep the templates
!.env.example
!frontend/.env.example


# ── Frontend — Node.js ────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/

# Vite build output
frontend/dist/
frontend/.vite/

# Vite preview cache
frontend/.cache/

# TypeScript / ESLint build info
*.tsbuildinfo
frontend/*.tsbuildinfo

# Yarn / pnpm / npm lock artefacts (keep package-lock.json or yarn.lock but not both)
# Uncomment whichever lock file you are NOT using:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Storybook
frontend/storybook-static/

# Bundle analyser output
frontend/stats.html


# ── OS artefacts ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverrideDirectory
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# ── IDE and editor ────────────────────────────────────────────────────────────
# VS Code — keep settings.json if you want to share workspace config,
# but ignore user-specific / extension state files
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-snippets
.vscode/.ropeproject

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*
.projectile

# Sublime Text
*.sublime-project
*.sublime-workspace


# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt


# ── Testing and coverage ──────────────────────────────────────────────────────
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
test-results/
junit*.xml
*.test-results.xml


# ── Type checkers and linters ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
pyrightconfig.json
.ruff_cache/


# ── Documentation build output ────────────────────────────────────────────────
docs/_build/
docs/site/
site/
.mkdocs/


# ── Temporary and scratch files ───────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.swp


# ── Profiling ─────────────────────────────────────────────────────────────────
*.prof
*.lprof
profile_output/

# ==========================================
# Virtual Environments & Packages
# ==========================================
.venv/
venv/
ENV/
env/
*.pyc
__pycache__/
*.so

# ==========================================
# Large Model Weights & Checkpoints
# ==========================================
models/*
!models/.gitkeep
*.pth
*.pt
*.h5
*.onnx
*.weights
*.bin
*.safetensors
*.ckpt

# ==========================================
# Datasets, Test Videos & Output Storage
# ==========================================
test_videos/*
!test_videos/.gitkeep
storage/*
!storage/.gitkeep
data/
dataset/
*.mp4
*.avi
*.mkv
*.mov

# ==========================================
# Environment Variables & Keys
# ==========================================
.env
!.env.example

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# Logs & Outputs
# ==========================================
*.log
runs/
wandb/