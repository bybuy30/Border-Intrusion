# ── Forest Intrusion Detection System — Environment Variables ─────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Camera / pole identification used in event logs
CAMERA_ID=camera_01
POLE_ID=pole_01

# Path to the trained YOLOv8 weights (relative to project root)
MODEL_WEIGHTS=models/best.pt

# Confidence threshold for detections (0.0–1.0)
CONFIDENCE_THRESHOLD=0.35

# IoU threshold for NMS (0.0–1.0)
IOU_THRESHOLD=0.45

# Firearm confidence threshold that triggers a special-priority alert
FIREARM_ALERT_THRESHOLD=0.40

# SQLite database path for event logs
DATABASE_PATH=storage/events/events.db

# Evidence image storage directory
EVIDENCE_DIR=storage/evidence

# Streamlit app port (default 8501)
STREAMLIT_PORT=8501

# ── FastAPI / React dashboard ─────────────────────────────────────────────────
# Port for the FastAPI server
API_PORT=8000

# Allowed frontend origin for CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
